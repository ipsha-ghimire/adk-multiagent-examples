# .gitignore - common ignores for Python projects, editors, OS files, and secrets
# Add or remove entries as appropriate for your repo.

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
*.egg-info/
.installed.cfg
*.egg
pip-wheel-metadata/
wheelhouse/

# Virtual environments
env/
venv/
ENV/
.venv/
.env/
.venvs/
venv.bak/

# Installer logs
pip-log.txt
pip-delete-this-directory.txt

# Unit test / coverage
htmlcov/
.tox/
.nox/
.coverage
.coverage.*
.cache
.pytest_cache/
nosetests.xml
coverage.xml
*,cover

# Jupyter Notebook checkpoints
.ipynb_checkpoints

# pyenv
.python-version

# pipenv
Pipfile.lock

# mypy
.mypy_cache/

# Type/typing caches
typings/

# IDEs and editors
.vscode/
.idea/
.gemini/
.codeoss/
*.sublime-project
*.sublime-workspace

# OS generated files
.DS_Store
Thumbs.db

# Logs and databases
*.log
logs/
*.sqlite3
*.db

# Secrets, keys, credentials (sensitive files)
.env
.env.*
!.env.example
!**/.env.example
secrets.*
credentials.json
credentials
*.pem
*.key
*.crt
*.p12
*.jks
*.pfx
id_rsa
id_rsa.pub
google-credentials.json
aws-credentials
netrc
.git-credentials

# Cloud SDK and credentials directories
.aws/
.azure/
.gcloud/
.config/
.docker/
.rustup/
.sudo_as_admin_successful

# ADK local runtime state
.adk/

# Misc
*.bak
*.swp
*~

# Shell histories and user configs
.bash_history
.bash_logout
.bashrc
.bash_profile
.profile
.zsh_history
.zshrc

# Node
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
/.npm/
.npm/
/.local/
.local/
.npm/_logs/
